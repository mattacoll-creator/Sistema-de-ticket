# ==============================================================================
# CONFIGURACIÓN DE ENTORNO: TEST / PRUEBAS
# ==============================================================================
# Puerto de escucha para ambiente de Test: 3000
# Base de datos para ambiente de Test: postgres
# ==============================================================================

NODE_ENV=production
PORT=3000

# ==============================================================================
# BASE DE DATOS AZURE POSTGRESQL (AMBIENTE TEST: postgres)
# ==============================================================================
# Descomente y configure con su servidor de Azure PostgreSQL si está disponible:
# PGHOST="servidor-te-pg.postgres.database.azure.com"
# PGPORT=5432
# PGUSER="usuario_admin"
# PGPASSWORD="PasswordSuperSeguro123"
PGDATABASE="postgres"
# PGSSLMODE="require"

# Cadena de conexión directa con la base de datos postgres (opcional en test)
# DATABASE_URL="postgresql://usuario_admin:PasswordSuperSeguro123@servidor-te-pg.postgres.database.azure.com:5432/postgres?sslmode=require"

# ==============================================================================
# SEGURIDAD Y SESIÓN
# ==============================================================================
SESSION_SECRET="clave_secreta_jwt_ambiente_test_tribunal_electoral_3000"
SUPER_ADMIN_PIN="1234"

# ==============================================================================
# CONFIGURACIÓN DE CORREO NOTIFICACIONES (OUTLOOK 365)
# ==============================================================================
OUTLOOK_EMAIL="notificaciones-test@tribunal-electoral.gob.pa"
OUTLOOK_PASSWORD="PasswordOutlook123"
OUTLOOK_HOST="smtp.office365.com"
OUTLOOK_PORT=587

# ==============================================================================
# RUTA DE ALMACENAMIENTO DE ARCHIVOS ADJUNTOS
# ==============================================================================
UPLOAD_DIR="uploads"
