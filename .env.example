# Puerto de ejecución del servidor Express (por defecto 3000 o inyectado por Azure/IIS)
PORT=3000
NODE_ENV=production

# =================================================================
# BASE DE DATOS: AZURE DATABASE FOR POSTGRESQL - FLEXIBLE SERVER
# =================================================================
# Opción A: Cadena de conexión directa (Recomendado)
DATABASE_URL="postgresql://usuario_admin:PasswordSuperSeguro123@servidor-te-pg.postgres.database.azure.com:5432/tribunal_db?sslmode=require"

# Opción B: Parámetros individuales para Azure PostgreSQL Flexible Server
PGHOST="servidor-te-pg.postgres.database.azure.com"
PGUSER="usuario_admin"
PGPASSWORD="PasswordSuperSeguro123"
PGDATABASE="tribunal_db"
PGPORT=5432
PGSSLMODE="require"

# =================================================================
# SERVICIO DE CORREO INSTITUCIONAL OUTLOOK / OFFICE 365
# =================================================================
OUTLOOK_USER=""
OUTLOOK_PASS=""
OUTLOOK_HOST="smtp.office365.com"
OUTLOOK_PORT=587

# =================================================================
# IA Y DOMINIO PÚBLICO
# =================================================================
GEMINI_API_KEY=""
APP_URL="https://midominio.com"
