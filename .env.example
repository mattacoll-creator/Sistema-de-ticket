# =================================================================
# PUERTO DE EJECUCIÓN DEL SERVIDOR (Express / Node.js)
# =================================================================
# Puerto estándar para Cloud Run / Contenedores y entornos de producción (3000)
PORT=3000
NODE_ENV=production

# (Opcional) Rutas a tus certificados SSL si inicias directamente con HTTPS nativo
# SSL_KEY_PATH="C:\certificados\servidor.key"
# SSL_CERT_PATH="C:\certificados\servidor.crt"

# =================================================================
# BASE DE DATOS: AZURE DATABASE FOR POSTGRESQL - FLEXIBLE SERVER
# =================================================================
# Opción A: Cadena de conexión directa (Recomendado)
DATABASE_URL="postgresql://usuario_admin:PasswordSuperSeguro123@servidor-te-pg.postgres.database.azure.com:5432/postgres?sslmode=require"

# Opción B: Parámetros individuales para Azure / Windows PostgreSQL
PGHOST="localhost"
PGUSER="postgres"
PGPASSWORD="PasswordSuperSeguro123"
PGDATABASE="postgres"
PGPORT=5432
PGSSLMODE="disable"

# =================================================================
# SERVICIO DE CORREO SMTP (SMTP2GO, OUTLOOK / OFFICE 365, SENDGRID)
# =================================================================
# Para SMTP2GO:
# OUTLOOK_HOST="mail.smtp2go.com"
# OUTLOOK_PORT=2525  (o 587, 8025, 465)
# OUTLOOK_USER="tu_usuario_smtp2go"
# OUTLOOK_PASS="tu_contraseña_o_api_key_smtp2go"
# SMTP_FROM="remitente_verificado@tudominio.com"

OUTLOOK_USER=""
OUTLOOK_PASS=""
OUTLOOK_HOST="smtp.office365.com"
OUTLOOK_PORT=587
SMTP_FROM=""

# =================================================================
# IA Y DOMINIO PÚBLICO
# =================================================================
GEMINI_API_KEY=""
APP_URL="https://midominio.com"
VITE_APP_VERSION="V5.15 test"

# =================================================================
# NOTIFICACIONES PUSH (VAPID)
# =================================================================
# Claves pública y privada para notificaciones Web Push. Requeridas en producción.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

